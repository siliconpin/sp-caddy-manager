curl -X POST http://localhost:3000/add-domain \
     -H "Content-Type: application/json" \
     -d '{"action":"add", "domain":"sub-domain1.siliconpin.com", "port":8000}'

curl -X POST http://localhost:3000/add-domain \
     -H "Content-Type: application/json" \
     -d '{"action":"delete", "domain":"sub-domain1.siliconpin.com"}'

